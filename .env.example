# Copy to .env, fill in, then: set -a && source .env && set +a
# (this tool reads os.environ directly -- no dotenv dependency, matching
# the reference repos' stdlib-only convention).

# --- New Relic ------------------------------------------------------------
# User API key (Account settings > API keys > "User key", starts with NRAK-).
# Needs NerdGraph read on: entities, alerts, workflow_automation.* -- and,
# best-effort/unconfirmed, AI monitoring + vulnerability management read.
# See README "Confidence legend" for which dimensions that affects.
NEW_RELIC_USER_KEY=NRAK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target account ID to score.
NEW_RELIC_ACCOUNT_ID=1234567

# "us" (default) or "eu" -- match the account/license key's region.
NEW_RELIC_REGION=us

# --- Optional overrides ---------------------------------------------------
# AI_READINESS_LOOKBACK_DAYS=30
